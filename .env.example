# Copy this file to ".env" and paste ONE real key below (you only need one).
# Never upload your .env file anywhere - it is already in .gitignore.

# Option 1: Google Gemini (free) - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Option 2: Groq (free) - get a key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# If both are filled in, Gemini is used.
